#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 24 "clipsync.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 260, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClipSync Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LINKED, 10, 13, 150, 10
    PUSHBUTTON      "Link a phone...", IDC_LINK, 166, 9, 84, 15
    LTEXT           "Name of this PC (shown on the phone):", -1, 10, 38, 170, 9
    EDITTEXT        IDC_NAME, 10, 49, 170, 14, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 190, 38, 60, 9
    EDITTEXT        IDC_PORT, 190, 49, 60, 14, ES_NUMBER
    AUTOCHECKBOX    "Use Bluetooth when Wi-Fi can't connect", IDC_BT, 10, 76, 160, 12
    PUSHBUTTON      "Bluetooth settings...", IDC_BTOPEN, 172, 74, 78, 15
    LTEXT           "For Bluetooth, pair the phone with this PC once in Bluetooth settings. After that, ClipSync connects by itself over Wi-Fi or Bluetooth, whichever works.", -1, 10, 96, 240, 27
    LTEXT           "", IDC_ADDR, 10, 132, 240, 45
    DEFPUSHBUTTON   "OK", IDOK, 146, 192, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 192, 50, 14
END

IDD_PAIR DIALOGEX 0, 0, 240, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Link a phone - ClipSync"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PAIR_TEXT, 12, 10, 216, 70
    CTEXT           "", IDC_PAIR_CODE, 12, 88, 216, 40, SS_CENTERIMAGE
    DEFPUSHBUTTON   "Link", IDOK, 122, 144, 50, 14, WS_DISABLED
    PUSHBUTTON      "Cancel", IDCANCEL, 178, 144, 50, 14
END

IDD_TRANSFER DIALOGEX 0, 0, 260, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "ClipSync"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_TX_TITLE, 12, 8, 236, 12, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT           "", IDC_TX_FILE, 12, 23, 236, 9, SS_ENDELLIPSIS | SS_NOPREFIX
    CONTROL         "", IDC_TX_BAR, "msctls_progress32", PBS_SMOOTH, 12, 36, 236, 8
    LTEXT           "", IDC_TX_DETAIL, 12, 49, 236, 18, SS_NOPREFIX
    PUSHBUTTON      "Open folder", IDC_TX_OPEN, 84, 72, 56, 14, NOT WS_VISIBLE
    PUSHBUTTON      "Cancel", IDC_TX_STOP, 144, 72, 50, 14
    PUSHBUTTON      "Hide", IDCANCEL, 198, 72, 50, 14
END

1 VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ClipSync"
            VALUE "ProductName", "ClipSync"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
