<Window x:Class="CmfLink.App.FlyoutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CmfLink.App.Controls"
        Title="CMF Link" Width="384" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ThemeMode="System" Background="Transparent" UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="Foreground" Value="#E8A13B" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <!-- A Windows 11 style toggle switch, for CheckBox. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Padding="16,12,16,12">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EnterOffset" />
        </Border.RenderTransform>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="-8,0,4,0"
                        Visibility="Collapsed" ToolTip="Back" AutomationProperties.Name="Back" Click="OnBack" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Text="CMF Buds 2a" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                        Margin="0,0,-8,0" ToolTip="More settings" AutomationProperties.Name="More settings" Click="OnMore" />
            </Grid>

            <!-- Shown instead of the controls while connecting, or when the channel can't open. -->
            <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,10,0,6">
                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" FontSize="13" />
                <Button x:Name="RetryButton" Content="Try again" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="OnRetry" />
            </StackPanel>

            <!-- Main page -->
            <StackPanel x:Name="MainPage">
                <UniformGrid Columns="3" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <c:BatteryRing x:Name="LeftRing" />
                        <TextBlock Text="Left" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <c:BatteryRing x:Name="CaseRing" />
                        <TextBlock Text="Case" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock x:Name="CaseAgeText" Style="{StaticResource Secondary}" FontSize="10.5" HorizontalAlignment="Center"
                                   Opacity="0.8" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <c:BatteryRing x:Name="RightRing" />
                        <TextBlock Text="Right" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Noise control" Style="{StaticResource Section}" />
                <c:SegmentedControl x:Name="NoiseSegments" AutomationProperties.Name="Noise control" />
                <TextBlock x:Name="NoiseErrorText" Style="{StaticResource Error}" />

                <StackPanel x:Name="EqSection">
                    <TextBlock Text="Equalizer" Style="{StaticResource Section}" />
                    <WrapPanel x:Name="EqPresets" Margin="0,0,-6,-6" />
                    <Border x:Name="CustomEqCard" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid x:Name="CustomEqGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid x:Name="UltraBassRow" Margin="0,2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ultra Bass" FontSize="13" />
                                <TextBlock x:Name="UltraBassLevelText" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <CheckBox x:Name="UltraBassSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" AutomationProperties.Name="Ultra Bass" Click="OnUltraBassToggled" />
                        </Grid>
                        <Slider x:Name="UltraBassSlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight" Margin="0,4,0,2" AutomationProperties.Name="Ultra Bass level"
                                Visibility="Collapsed" />
                        <Separator x:Name="LatencySeparator" Margin="0,6" />
                        <Grid x:Name="LatencyRow" Margin="0,2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Low latency" FontSize="13" />
                                <TextBlock Text="For games and video" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <CheckBox x:Name="LatencySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" AutomationProperties.Name="Low latency" Click="OnLatencyToggled" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SettingsErrorText" Style="{StaticResource Error}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="RingLeft" HorizontalAlignment="Stretch" Click="OnRing" Tag="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="RingLeftText" Text="Ring left" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="RingRight" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnRing" Tag="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="RingRightText" Text="Ring right" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <TextBlock Text="Take the buds out of your ears first. The ring is loud." Style="{StaticResource Secondary}"
                           FontSize="11" Margin="2,6,0,0" />
            </StackPanel>

            <!-- More page -->
            <StackPanel x:Name="MorePage" Visibility="Collapsed">
                <StackPanel x:Name="GestureSection">
                    <TextBlock Text="Gestures" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="GestureGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DualSection">
                    <TextBlock Text="Connections" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="DualList" />
                    </Border>
                </StackPanel>

                <TextBlock Text="CMF Link" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="AppSettings" />
                </Border>

                <Grid Margin="2,12,0,0">
                    <TextBlock x:Name="FooterText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    <Button Content="Quit" HorizontalAlignment="Right" Click="OnQuit" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
