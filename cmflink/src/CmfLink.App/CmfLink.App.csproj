<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tray icon, flyout and settings. No Bluetooth logic lives here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>CmfLink</AssemblyName>
    <RootNamespace>CmfLink.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CmfLink.ico</ApplicationIcon>
    <!-- ThemeMode (the Windows 11 Fluent theme) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TieredPGO>true</TieredPGO>
    <!-- Precompiled, so launching and connecting don't pay for the JIT (less CPU and less memory). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CmfLink.Bluetooth\CmfLink.Bluetooth.csproj" />
  </ItemGroup>
</Project>
